{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".shared/**", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:dev": {},
    "test": {},
    "test:ci": {},
    "clean": {},
    "format": {},
    "format:fix": {},
    "build-types": {
      "dependsOn": ["^build-types"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["build-types"]
    },
    "lint": {},
    "lint:fix": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
